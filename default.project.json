{
  "name": "my-roblox-game",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 2.6,
        "ClockTime": 14.5,
        "GeographicLatitude": 35,
        "Ambient": [0.42, 0.45, 0.55],
        "OutdoorAmbient": [0.62, 0.66, 0.74],
        "ColorShift_Top": [1.0, 0.96, 0.88],
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "ShadowSoftness": 0.35,
        "GlobalShadows": true
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.12,
          "Color": [0.78, 0.88, 1.0],
          "Decay": [0.55, 0.74, 0.95],
          "Glare": 0.2,
          "Haze": 1.1
        }
      },
      "Sky": {
        "$className": "Sky",
        "$properties": {
          "SunAngularSize": 14,
          "CelestialBodiesShown": true
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.35,
          "Size": 24,
          "Threshold": 1.6
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": 0.18,
          "Contrast": 0.06,
          "Brightness": 0.02
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.04,
          "Spread": 0.6
        }
      }
    }
  }
}
