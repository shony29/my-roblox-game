{
  "name": "my-roblox-game",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "StarterPlayer": {
      "$properties": {
        "LoadCharacterAppearance": false,
        "CameraMode": "LockFirstPerson",
        "CameraMaxZoomDistance": 0.5
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
